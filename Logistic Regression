      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-x))"
      ],
      "metadata": {
        "id": "OfmDnpVUFQ0C"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "purchase_prob = sigmoid((customer_age - 40) / 5)\n",
        "purchase_decision = np.random.binomial(1, purchase_prob)"
      ],
      "metadata": {
        "id": "5zxFfcznFljc"
      },
      "execution_count": null,
      "outputs": []
    },
    {
